# jota-gateway — configuración de ejemplo.
#
# Copia a `.env` y ajusta:   cp .env.sample .env
# Cada línea corresponde a un campo de `src/core/config.py::Settings`; los valores
# activos son los defaults (tests/unit/test_env_sample.py lo comprueba).
#
# Las direcciones de servicios son `host:port` SIN protocolo: cada cliente añade
# `http://` o `ws://` por su cuenta. No pongas URLs completas.
#
# OBLIGATORIAS para operar de verdad:  ADMIN_TOKEN, OPENCLAW_TOKEN.
# El resto es opcional: déjalo como está salvo que tu despliegue lo requiera.

# ── Base de datos ────────────────────────────────────────────────────────────
# Fichero SQLite local. El directorio padre se crea solo si no existe.
DATABASE_URL=sqlite:///data/gateway.db

# Un solo proceso por base de datos: el gateway toma un flock sobre `gateway.lock` junto a
# la BD y se niega a arrancar si otro proceso ya lo tiene (multi-worker no está soportado:
# sesiones, cachés y registro de bridges son por proceso). `false` desactiva el guard.
# Con `uvicorn --reload` funciona (el proceso viejo suelta el lock antes de lanzar el nuevo).
SINGLE_PROCESS_LOCK=true

# ── Revocación de sesiones vivas ─────────────────────────────────────────────
# Cada sesión WS se revalida contra la BD cada N s; si el cliente fue borrado, desactivado o
# su clave rotada, se cierra con 1008 «revoked». Sin caché: un cambio por /admin/* o por la
# CLI corta la sesión en la siguiente revalidación (≤ intervalo).
SESSION_REVALIDATE_INTERVAL_S=10.0

# ── Admin API (/admin/*) ─────────────────────────────────────────────────────
# OBLIGATORIA. Se envía en la cabecera `X-Admin-Token`. Se deja vacía a propósito:
# vacía => /admin/* responde 503 (fail-closed) en vez de aceptar un token por defecto.
# Genera uno con:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# ── Auth de /v1/* (compatible OpenAI, p. ej. Home Assistant) ─────────────────
# Un origen "de confianza" no necesita credenciales. El resto debe enviar
# `Authorization: Bearer <client_key>` (la misma clave que usa el handshake WS).
#
# Si true, 127.0.0.1 / ::1 quedan exentos de auth, SALVO que el peer esté en
# TRUSTED_PROXIES (más abajo): entonces manda `X-Real-IP`, y sin él se exige Bearer.
# Con TRUSTED_PROXIES vacío y un proxy en el mismo host, TODO Internet sería "loopback":
# el gateway avisa con un WARNING al arrancar.
TRUST_LOOPBACK=true
# CSV de CIDRs exentos de auth, p. ej. 192.168.1.0/24. Vacío = fail-closed
# (solo loopback, si TRUST_LOOPBACK=true).
TRUSTED_NETWORKS=
# CSV de IPs/CIDRs autorizados a fijar `X-Real-IP` (tu reverse proxy). Cualquier
# otro peer que lo envíe es ignorado, para evitar suplantar la IP de origen.
# Un peer de esta lista SIN `X-Real-IP` válido no es origen de confianza (se exige Bearer):
# el proxy debe sobrescribir `X-Real-IP`, no reenviar el del cliente. Sin proxy y con
# clientes directos en loopback sin Bearer, déjala vacía.
TRUSTED_PROXIES=127.0.0.1,::1
# (Solo imagen Docker, no es un campo de Settings) GATEWAY_HOST=127.0.0.1 hace que uvicorn
# escuche solo en loopback; default 0.0.0.0.

# ── Orquestador: OpenClaw ────────────────────────────────────────────────────
OPENCLAW_HOST=127.0.0.1
OPENCLAW_PORT=18789
# OBLIGATORIA. Token del gateway de OpenClaw (`gateway.auth.token` en openclaw.json).
OPENCLAW_TOKEN=changeme
# Reconexión con backoff exponencial (segundos). Pasada MAX_DURATION entra en
# DEGRADED (/ready responde 503) pero sigue reintentando despacio: un intento cada
# MAX_BACKOFF s hasta que OpenClaw vuelva; la reconexión manual desde el admin sigue
# disponible y toma el relevo al instante.
ORCHESTRATOR_RECONNECT_INITIAL_BACKOFF=1.0
ORCHESTRATOR_RECONNECT_MAX_BACKOFF=60.0
ORCHESTRATOR_RECONNECT_MAX_DURATION=300.0

# ── Transcriptor (STT) ───────────────────────────────────────────────────────
# host:port sin protocolo.
TRANSCRIBER_WS_URL=localhost:9000
# Token de servicio = AUTH_TOKEN de jota-transcriber. Vacío = transcriber sin auth.
# El gateway ya no le reenvía la client_key del cliente (#218).
TRANSCRIBER_TOKEN=
TRANSCRIBER_RECONNECT_INITIAL_BACKOFF=1.0
TRANSCRIBER_RECONNECT_MAX_BACKOFF=60.0
TRANSCRIBER_RECONNECT_MAX_DURATION=300.0

# ── TTS ──────────────────────────────────────────────────────────────────────
# host:port sin protocolo.
TTS_WS_URL=localhost:8005
TTS_TOKEN=gateway
# Proveedores de voz (jota = servicios propios). Se pueden cambiar en caliente con
# PUT /admin/speech (no se persiste: al reiniciar rigen estos valores).
STT_PROVIDER=jota
TTS_PROVIDER=jota
# Segundos máximos para completar la autenticación con el servicio TTS.
TTS_AUTH_TIMEOUT_S=10.0
# Segundos máximos que el Transcriber tiene para responder `ready` tras el handshake.
TRANSCRIBER_READY_TIMEOUT_S=10.0
# TTS no mantiene socket entre turnos: backoff perezoso, sin estado DEGRADED.
TTS_RECONNECT_INITIAL_BACKOFF=1.0
TTS_RECONNECT_MAX_BACKOFF=60.0

# ── Plazos acotados (segundos) ───────────────────────────────────────────────
# Máximo para recibir el handshake tras conectar el WebSocket (antes 10 s; bajado a 5 s
# en #216: un cliente muy lento, p. ej. un ESP32 con mala cobertura, puede necesitar subirlo).
HANDSHAKE_TIMEOUT_S=5.0
# Tamaño máximo (CARACTERES, no bytes) del primer mensaje del WebSocket; se comprueba antes de
# parsearlo/autenticarlo y se cierra con 1008 "Handshake too large". Aparte, la imagen
# arranca uvicorn con `--ws-max-size 1048576` (1 MiB) para cualquier mensaje entrante;
# ese flag solo está en el CMD de la imagen: con `uvicorn` a mano rige el tope de 16 MiB.
HANDSHAKE_MAX_BYTES=4096
# Hueco máximo SIN eventos durante un turno (se reinicia con cada evento).
TURN_TIMEOUT_S=120.0
# Cierra la sesión si el cliente no envía nada en este tiempo (sin aviso previo).
IDLE_TIMEOUT_S=300.0
# Ventana de gracia al apagar para que las sesiones activas terminen su turno.
SHUTDOWN_DRAIN_S=30.0
# Tope de cada espera del TTS: turnos de push (#130 S3a, #199) y normales (#214). Por
# operación; la espera del audio de un turno normal es por tiempo SIN progreso (se
# reinicia con cada chunk).
PUSH_TTS_DRAIN_TIMEOUT_S=30.0
# Un envío al cliente bloqueado más de este tiempo lo marca como lento y cierra la
# conexión (issue #130 S2). Es por envío, no acumulado.
CLIENT_SEND_TIMEOUT_S=10.0
# Eventos máximos en la cola de un turno de OpenClaw (issue #130 S3b). Si el consumidor
# se atrasa y se llena, el turno se aborta (TURN_ERROR "turn_overflow") sin bloquear a
# las demás sesiones.
TURN_QUEUE_MAX=1000

# ── Proveedores de voz (src/services/speech/) ────────────────────────────────
# TTS y STT "elevenlabs" implementados (fases 3 y 4). STT_PROVIDER/TTS_PROVIDER: ver arriba.
# ELEVENLABS_API_KEY=
# ELEVENLABS_BASE_URL=wss://api.elevenlabs.io
# El resto de ajustes de ElevenLabs son constantes en src/services/speech/elevenlabs/ (#264).
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Voz por defecto (español, no es un secreto); solo falla el arranque si se deja en blanco.
# ELEVENLABS_TTS_DEFAULT_VOICE=gc61tTk93h3LBXPxew2V
# Mapa JSON voz del cliente -> voz del proveedor, p. ej. {"af_heart":"<voice_id>"}
# TTS_VOICE_MAP={}
# Puerta de energía del STT de ElevenLabs (solo envía audio mientras se habla): energy u off.
# jota no la usa. Antes admitía `auto`, que ya no es válido (#264).
# STT_AUDIO_GATE=energy
# STT_GATE_RMS_DBFS=-45.0
# Formato de los logs: text (por defecto) o json (una línea JSON por registro; la imagen Docker usa json).
# LOG_FORMAT=text
