# jota-gateway — configuración de ejemplo.
#
# Copia a `.env` y ajusta:   cp .env.sample .env
# Cada línea corresponde a un campo de `src/core/config.py::Settings`; los valores
# activos son los defaults (tests/unit/test_env_sample.py lo comprueba).
#
# Las direcciones de servicios son `host:port` SIN protocolo: cada cliente añade
# `http://` o `ws://` por su cuenta. No pongas URLs completas.
#
# OBLIGATORIAS para operar de verdad:  ADMIN_TOKEN, OPENCLAW_TOKEN.
# El resto es opcional: déjalo como está salvo que tu despliegue lo requiera.

# ── Base de datos ────────────────────────────────────────────────────────────
# Fichero SQLite local. El directorio padre se crea solo si no existe.
DATABASE_URL=sqlite:///data/gateway.db

# ── Admin API (/admin/*) ─────────────────────────────────────────────────────
# OBLIGATORIA. Se envía en la cabecera `X-Admin-Token`. Se deja vacía a propósito:
# vacía => /admin/* responde 503 (fail-closed) en vez de aceptar un token por defecto.
# Genera uno con:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# ── Auth de /v1/* (compatible OpenAI, p. ej. Home Assistant) ─────────────────
# Un origen "de confianza" no necesita credenciales. El resto debe enviar
# `Authorization: Bearer <client_key>` (la misma clave que usa el handshake WS).
#
# Si true, 127.0.0.1 / ::1 quedan exentos de auth.
TRUST_LOOPBACK=true
# CSV de CIDRs exentos de auth, p. ej. 192.168.1.0/24. Vacío = fail-closed
# (solo loopback, si TRUST_LOOPBACK=true).
TRUSTED_NETWORKS=
# CSV de IPs/CIDRs autorizados a fijar `X-Real-IP` (tu reverse proxy). Cualquier
# otro peer que lo envíe es ignorado, para evitar suplantar la IP de origen.
TRUSTED_PROXIES=127.0.0.1,::1

# ── Orquestador: OpenClaw ────────────────────────────────────────────────────
OPENCLAW_HOST=127.0.0.1
OPENCLAW_PORT=18789
# OBLIGATORIA. Token del gateway de OpenClaw (`gateway.auth.token` en openclaw.json).
OPENCLAW_TOKEN=changeme
# Reconexión con backoff exponencial (segundos). Pasada MAX_DURATION entra en
# DEGRADED y deja de reintentar hasta una reconexión manual desde el admin.
ORCHESTRATOR_RECONNECT_INITIAL_BACKOFF=1.0
ORCHESTRATOR_RECONNECT_MAX_BACKOFF=60.0
ORCHESTRATOR_RECONNECT_MAX_DURATION=300.0

# ── Transcriptor (STT) ───────────────────────────────────────────────────────
# host:port sin protocolo.
TRANSCRIBER_WS_URL=localhost:9000
TRANSCRIBER_RECONNECT_INITIAL_BACKOFF=1.0
TRANSCRIBER_RECONNECT_MAX_BACKOFF=60.0
TRANSCRIBER_RECONNECT_MAX_DURATION=300.0

# ── TTS ──────────────────────────────────────────────────────────────────────
# host:port sin protocolo.
TTS_WS_URL=localhost:8005
TTS_TOKEN=gateway
# Segundos máximos para completar la autenticación con el servicio TTS.
TTS_AUTH_TIMEOUT_S=10.0
# Segundos máximos que el Transcriber tiene para responder `ready` tras el handshake.
TRANSCRIBER_READY_TIMEOUT_S=10.0
# TTS no mantiene socket entre turnos: backoff perezoso, sin estado DEGRADED.
TTS_RECONNECT_INITIAL_BACKOFF=1.0
TTS_RECONNECT_MAX_BACKOFF=60.0

# ── Plazos acotados (segundos) ───────────────────────────────────────────────
# Máximo para recibir el handshake tras conectar el WebSocket.
HANDSHAKE_TIMEOUT_S=10.0
# Hueco máximo SIN eventos durante un turno (se reinicia con cada evento).
TURN_TIMEOUT_S=120.0
# Cierra la sesión si el cliente no envía nada en este tiempo (sin aviso previo).
IDLE_TIMEOUT_S=300.0
# Ventana de gracia al apagar para que las sesiones activas terminen su turno.
SHUTDOWN_DRAIN_S=30.0
# Drenado acotado del audio TTS al cerrar un turno de push (issue #130 S3a).
PUSH_TTS_DRAIN_TIMEOUT_S=30.0
# Un envío al cliente bloqueado más de este tiempo lo marca como lento y cierra la
# conexión (issue #130 S2). Es por envío, no acumulado.
CLIENT_SEND_TIMEOUT_S=10.0
