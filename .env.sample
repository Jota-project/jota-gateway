# jota-db (identidad y configuración)
JOTA_DB_BASE_URL=jota-db:8001
JOTA_DB_API_KEY=changeme

# Orchestrator
ORCHESTRATOR_BASE_URL=jota-orchestrator:8000
# Clave que usa el gateway para autenticarse contra el orchestrator (e.g. health checks)
GATEWAY_KEY=gateway

# Transcriber (jota-transcriber)
TRANSCRIBER_WS_URL=jota-transcriber:9000

# TTS (jota-speaker)
TTS_WS_URL=jota-speaker:8005
TTS_TOKEN=gateway

# Behaviour
BARGE_IN_MIN_CHARS=5
TRANSCRIBER_SILENCE_TIMEOUT_S=25
